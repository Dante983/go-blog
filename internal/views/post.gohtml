{{ define "post" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
</head>
<body>
    <div class="container">
        <header>
            <pre style="color: #00ff00; font-size: 16px; line-height: 1; margin-bottom: 10px;">
╔══════════════════════════════════════════════════════════════╗
║  _   _ _ _         _       _       ____  _                   ║
║ | \ | (_) | _____ | | __ _( )___  | __ )| | ___   __ _      ║
║ |  \| | | |/ / _ \| |/ _` |// __| |  _ \| |/ _ \ / _` |     ║
║ | |\  | |   < (_) | | (_| | \__ \ | |_) | | (_) | (_| |     ║
║ |_| \_|_|_|\_\___/|_|\__,_| |___/ |____/|_|\___/ \__, |     ║
║                                                   |___/      ║
╚══════════════════════════════════════════════════════════════╝
            </pre>
            <nav>
                <a href="/">[ HOME ]</a> 
                <a href="/posts">[ ALL POSTS ]</a> 
                {{ if .IsAuthenticated }}
                    <a href="/admin/posts/new">[ NEW POST ]</a>
                    <a href="/logout">[ LOGOUT ]</a>
                {{ else }}
                    <a href="/login">[ LOGIN ]</a>
                {{ end }}
            </nav>
        </header>

        <article class="post">
            <h1>{{ .PostTitle }}</h1>
            <time>{{ .CreatedAt.Format "January 2, 2006" }}</time>
            
            <div class="post-content">
                {{ .ContentHTML }}
            </div>
            
            <hr>
            <p><a href="/posts">← Back to all posts</a></p>
        </article>
    </div>
</body>
</html>
{{ end }} 