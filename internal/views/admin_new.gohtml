{{ define "admin_new" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
</head>
<body>
    <div class="container">
        <header>
            <pre style="color: #00ff00; font-size: 16px; line-height: 1; margin-bottom: 10px;">
╔══════════════════════════════════════════════════════════════╗
║  _   _ _ _         _       _       ____  _                   ║
║ | \ | (_) | _____ | | __ _( )___  | __ )| | ___   __ _      ║
║ |  \| | | |/ / _ \| |/ _` |// __| |  _ \| |/ _ \ / _` |     ║
║ | |\  | |   < (_) | | (_| | \__ \ | |_) | | (_) | (_| |     ║
║ |_| \_|_|_|\_\___/|_|\__,_| |___/ |____/|_|\___/ \__, |     ║
║                                                   |___/      ║
╚══════════════════════════════════════════════════════════════╝
            </pre>
            <nav>
                <a href="/">[ HOME ]</a> 
                <a href="/posts">[ ALL POSTS ]</a> 
                {{ if .IsAuthenticated }}
                    <a href="/admin/posts/new">[ NEW POST ]</a>
                    <a href="/logout">[ LOGOUT ]</a>
                {{ else }}
                    <a href="/login">[ LOGIN ]</a>
                {{ end }}
            </nav>
        </header>

        <h2>Create a New Post</h2>

        <form 
            hx-post="/admin/posts" 
            hx-target="#result" 
            hx-swap="innerHTML"
        >
            <label>Title: <input type="text" name="title" required></label><br>
            <label>Slug: <input type="text" name="slug" required></label><br>
            <label>Content:</label><br>
            <textarea name="content" rows="6" cols="50" required></textarea><br>
            <button type="submit">Create Post</button>
        </form>

        <div id="result"></div>
    </div>
</body>
</html>
{{ end }}
